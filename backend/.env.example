# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=security_monitor
DB_USERNAME=root
DB_PASSWORD=your_secure_database_password_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here

# JWT Configuration
# CRITICAL: Generate a strong secret key using: openssl rand -base64 64
# This key MUST be at least 256 bits (32 bytes) for HS256 algorithm
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long_generate_with_openssl_rand_base64_64
JWT_EXPIRATION=86400000

# Storage Configuration
# Use absolute path in production, relative path for development
STORAGE_BASE_PATH=./storage

# Server Configuration (optional)
SERVER_PORT=8080
